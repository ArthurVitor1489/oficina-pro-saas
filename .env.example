# Turso / libSQL Database configuration
# Para desenvolvimento local offline: file:local.db
# Para produção no Turso: libsql://[sua-oficina].turso.io
DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# Autenticação e Criptografia
AUTH_SECRET="oficina_pro_super_secret_session_key_min_32_characters_random_string_2026"

# Configuração da Aplicação
NEXT_PUBLIC_APP_NAME="OficinaPro"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
